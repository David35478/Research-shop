# Copy to .env (never commit .env) and fill in real values.
# On Vercel, set these in Settings -> Environment Variables instead.

# Claude-compatible inference key (required for real report generation)
ANTHROPIC_API_KEY=

# Agent's restricted function-call access key (optional; enables live payouts)
AGENT_NEAR_PRIVATE_KEY=

# Payment/inference integrations (optional)
OUTLAYER_API_KEY=
ZAI_API_KEY=
